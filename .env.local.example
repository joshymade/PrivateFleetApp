# Supabase Cloud — Project Settings → API
# URL looks like: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Prefer the publishable key (sb_publishable_...); legacy anon JWT also works
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never NEXT_PUBLIC_). Dashboard → API → secret / service_role
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct Postgres for local CLI / tooling (Dashboard → Database → Connection string).
# Not required for the Next.js app when using Supabase clients + MCP migrations.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Cloudflare R2 (damage photos) — see docs/r2-setup.md
# Server-only credentials for presigned PUT (never NEXT_PUBLIC_)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public/CDN base for Feed display (*.r2.dev or custom domain — NOT *.r2.cloudflarestorage.com)
R2_PUBLIC_URL=

# Resend (driver Contact Admin emails) — https://resend.com
# Server-only. Create an API key in the Resend dashboard.
RESEND_API_KEY=
# Verified sender, e.g. PrivateFleet <noreply@yourdomain.com>
# Falls back to onboarding@resend.dev for Resend test sends only.
RESEND_FROM_EMAIL=
